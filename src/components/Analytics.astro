---
// Renders the Cloudflare Web Analytics beacon script when a token is
// available via the PUBLIC_CF_BEACON_TOKEN build-time env var. Omitted
// entirely when no token is set.
const token = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{
  token && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${token}"}`}
    />
  )
}
