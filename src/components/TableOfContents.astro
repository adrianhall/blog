---
// Table of contents built from the headings extracted from a post's MDX.
// Only h2/h3 are shown. Renders nothing if there are no matching headings.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

interface TocEntry {
  slug: string;
  text: string;
  children: TocEntry[];
}

function buildToc(items: MarkdownHeading[]): TocEntry[] {
  const top: TocEntry[] = [];
  let currentTop: TocEntry | null = null;

  for (const heading of items) {
    if (heading.depth <= 2) {
      currentTop = { slug: heading.slug, text: heading.text, children: [] };
      top.push(currentTop);
    } else if (heading.depth === 3 && currentTop) {
      currentTop.children.push({ slug: heading.slug, text: heading.text, children: [] });
    }
    // depth > 3 is ignored.
  }
  return top;
}

const toc = buildToc(headings.filter((h) => h.depth >= 2 && h.depth <= 3));
---

{
  toc.length > 0 && (
    <nav class="toc" aria-label="Table of contents">
      <h2>On this page</h2>
      <ol>
        {toc.map((entry) => (
          <li>
            <a href={`#${entry.slug}`}>{entry.text}</a>
            {entry.children.length > 0 && (
              <ol class="toc-sub">
                {entry.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
