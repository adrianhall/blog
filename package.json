{
  "name": "adrianhall-blog",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "astro check",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && npm run check-build",
    "preview": "astro preview",
    "check": "astro check && npm run check-build",
    "check-build": "node scripts/check-build.mjs",
    "publish": "npm run build && npm run check && wrangler deploy",
    "prestart": "astro check",
    "start": "astro dev"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.0",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.106.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "workerd@1.20260630.1": true,
    "fsevents@2.3.3": true
  }
}
